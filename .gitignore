# Original game media and extracted proprietary content are kept out of Git.
/source-media-working-copy/**
!/source-media-working-copy/.gitkeep

# Build outputs and local IDE/tool configuration.
/build/
/cmake-build-*/
/.gradle/
/local.properties
/.idea/
/.vscode/
*.apk
*.aab
*.so
*.o
*.a
*.class
*.log

# Python test/tool caches.
__pycache__/
.pytest_cache/
*.pyc

# Ghidra project databases may contain imported proprietary executables.
*.gpr
*.rep/
*.lock

# Android/Gradle native build outputs.
**/build/
.cxx/
.externalNativeBuild/
*.iml
*.jks
*.keystore

# Do not commit original/proprietary game media or executables.
*.7z
*.bin
*.cue
*.iso
*.elf
*.gzf
*.pss
*.tim
*.vag
*.adx
# Additional proprietary PS2 payloads observed in this release.
*.irx
*.sq
*.hd
*.bd
*.gat
*.img
*.old
*.new
*.41

# ISO9660 names often retain the ;1 version suffix, so plain *.tim/*.pss
# patterns alone do not reliably exclude extracted originals.
*.[tT][iI][mM];*
*.[pP][sS][sS];*
*.[bB][iI][nN];*
*.[sS][qQ];*
*.[iI][rR][xX];*
*.[hH][dD];*
*.[bB][dD];*
*.[gG][aA][tT];*
*.[iI][mM][gG];*
*.[oO][lL][dD];*
*.[nN][eE][wW];*
*.[4][1];*
